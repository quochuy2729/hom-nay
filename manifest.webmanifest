    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Ghi nhanh bằng một câu", "short_name": "Ghi nhanh", "description": "Gõ hoặc nói: cà phê 30k, họp 9h mai", "url": "./?add=quick", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Thêm việc", "short_name": "Thêm việc", "description": "Việc cần làm, hạn nộp", "url": "./?add=task", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Ghi chi tiêu", "short_name": "Ghi chi", "description": "Khoản chi hôm nay", "url": "./?add=tx", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Lịch", "short_name": "Lịch", "description": "Lịch tháng, lịch học và lịch thi", "url": "./?tab=cal", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
